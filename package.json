{
  "name": "textcast-chat-axi",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "description": "Reading-companion and revision AXI for Textcast",
  "type": "module",
  "bin": {
    "textcast-chat-axi": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test",
    "start": "node dist/cli.mjs",
    "lint": "eslint bin src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.8",
    "chokidar": "^4.0.3",
    "cross-spawn": "7.0.6",
    "express": "^5.2.1",
    "open": "^10.2.0",
    "parse5": "^8.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "axi",
    "agent",
    "cli",
    "html",
    "review",
    "collaboration",
    "textcast"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veardk/textcast-chat-axi.git"
  },
  "bugs": {
    "url": "https://github.com/veardk/textcast-chat-axi/issues"
  },
  "homepage": "https://github.com/veardk/textcast-chat-axi#readme",
  "publishConfig": {
    "access": "public"
  }
}
